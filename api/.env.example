# Off by default everywhere, including local dev, so a future public
# deployment is safe unless someone deliberately opts in. Enables
# POST /api/scan-package, which runs `npm install` + a Docker build for
# whatever package name a request sends - fine on your own machine,
# a real abuse surface if this API is ever reachable by strangers.
ALLOW_LIVE_PACKAGE_SCAN=false

# Which LLM answers the semantic tool-poisoning check. Local dev leaves
# this unset and uses "ollama" (localhost:11434, $0, no key) by default.
# The deployed site can't reach a model on your laptop, so it sets this
# to "groq" instead - still $0 (free tier), but needs a real key from
# console.groq.com.
LLM_PROVIDER=ollama
GROQ_API_KEY=
